  },
  "dependencies": {
    "@spendguard/contracts": "*",
    "@spendguard/core": "*",
    "@spendguard/serv": "*"
  },
  "devDependencies": {
    "@spendguard/ledger": "*",
    "@types/node": "^22.5.0",
    "vitest": "^2.1.1"
  }
}